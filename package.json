{
  "name": "kabotar",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "build:emoji": "python3 scripts/build-emoji-font.py ~/Downloads/AppleColorEmoji-Linux.ttf --output static/emoji/font",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
  },
  "devDependencies": {
    "@better-auth/cli": "~1.4.21",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.4",
    "@inlang/paraglide-js": "^2.18.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.61.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.4",
    "better-auth": "~1.4.22",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.55.9",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.3",
    "vite-plugin-devtools-json": "^1.0.0",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.7",
    "@inlang/plugin-m-function-matcher": "^2.2.6",
    "@inlang/plugin-message-format": "^4.4.0",
    "@libsql/client": "^0.17.3",
    "@libsql/linux-x64-gnu": "^0.5.29",
    "@lottiefiles/dotlottie-svelte": "^0.10.3",
    "@lucide/svelte": "^1.16.0",
    "@sveltejs/mcp": "^0.1.23",
    "@types/bun": "^1.3.14",
    "@types/uuid": "^11.0.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "escape-goat": "^4.0.0",
    "file-type": "^22.0.1",
    "grep": "^0.1.0",
    "marked": "^18.0.4",
    "mdsvex": "^0.12.7",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "svelte-adapter-uws": "^0.5.8",
    "svelte-realtime": "^0.5.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.67.0",
    "zod": "^4.4.3"
  }
